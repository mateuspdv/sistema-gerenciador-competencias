<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20240727135245-1" author="Mateus Padovan Pereira">
        <createTable tableName="competency">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="boolean">
                <constraints nullable="false"/>
            </column>
            <column name="id_category" type="bigint">
                <constraints nullable="false" foreignKeyName="fk_competency_category" references="category(id)"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="20240727140550-2" author="Mateus Padovan Pereira">
        <createSequence sequenceName="sequence_competency"
                        dataType="bigint"
                        startValue="1"
                        incrementBy="1"/>
    </changeSet>

</databaseChangeLog>